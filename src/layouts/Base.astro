---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import Navigation from '../components/Navigation.astro';
import PiedDePage from '../components/PiedDePage.astro';
import { getCabinet, getSoins } from '../lib/content';
import { construireJsonLd } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  // Seul l'accueil a un hero sous lequel glisser une nav transparente.
  nav?: 'hero' | 'barre';
}

const { title, description, nav = 'barre' } = Astro.props;

const cabinet = await getCabinet();
const soins = await getSoins();
const jsonLd = construireJsonLd(cabinet, soins);
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Caroline, Massage Sur-Mesure" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <Font cssVariable="--font-titre" preload />
    <Font cssVariable="--font-texte" preload />
    <slot name="head" />
  </head>
  <body>
    {/* Les repères (header, nav, main, footer) satisfont déjà le SC 2.4.1 pour
        qui navigue au lecteur d'écran ; ce lien couvre l'autre moitié du
        public, au clavier sans lecteur d'écran, qui traverserait sinon toute
        la navigation. Il ne se montre qu'une fois atteint au clavier. */}
    <a href="#contenu" class="lien-evitement">Aller au contenu</a>
    <Navigation variante={nav} />
    <slot />
    <PiedDePage />
  </body>
</html>

<style is:global>
  /* Le design fait défiler jusqu'aux ancres en douceur, et retombe sur un saut
     sec quand le visiteur demande moins d'animation (`smooth` / `auto` selon
     `reducedMotion()`). Ici la même règle tient en CSS, sans une ligne de
     script. `scroll-margin-top` sur les sections écarte l'ancre de la barre
     collante des pages secondaires. */
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  html {
    /* Empêche un navigateur en thème sombre de repeindre la barre en sombre
       alors que la page, elle, reste claire. */
    color-scheme: light;
  }

  /* Barre de défilement aux couleurs de la page. Deux écritures, et surtout
     pas les deux à la fois : dès que `scrollbar-color` vaut autre chose que
     `auto`, il l'emporte sur les pseudo-éléments WebKit et n'en laisse rien
     passer.
     Chrome, Edge et Safari prennent donc la version détaillée, seule à donner
     la main sur la largeur et les angles. Poser cette largeur a un effet
     décisif : « when you set the width or height of ::-webkit-scrollbar, an
     overlay scrollbar is always displayed, effectively turning it into a
     classic scrollbar » (developer.chrome.com/docs/css-ui/scrollbar-styling).
     Sans elle, un système réglé sur les barres superposées dessine la piste
     mais escamote le curseur — la barre perd alors ce qui fait son utilité,
     dire où l'on se trouve dans la page.
     12px laisse de quoi l'attraper à la souris, là où les 8 à 10px habituels
     deviennent ingrats pour un pointage imprécis. */
  @supports selector(::-webkit-scrollbar) {
    html::-webkit-scrollbar {
      width: 12px;
      height: 12px;
    }

    html::-webkit-scrollbar-track {
      background: var(--sable);
    }

    html::-webkit-scrollbar-thumb {
      background: var(--vert-profond);
      border-radius: 999px;
      /* Bordure de la couleur de la piste : elle amincit le curseur sans
         réduire la surface réellement cliquable. */
      border: 3px solid var(--sable);
    }

    html::-webkit-scrollbar-thumb:hover {
      background: var(--vert-clair);
    }
  }

  /* Firefox, qui ne connaît pas ces pseudo-éléments. Le curseur d'abord, la
     piste ensuite : les deux teintes mesurent 6,5:1 l'une contre l'autre, au-
     dessus du plancher de 3:1 que demande la technique G183 du WCAG pour
     distinguer un contrôle de son fond. */
  @supports not selector(::-webkit-scrollbar) {
    html {
      scrollbar-color: var(--vert-profond) var(--sable);
    }
  }

  body {
    margin: 0;
    background: var(--creme);
    color: var(--encre);
    font-family: var(--font-texte), system-ui, sans-serif;
  }

  /* Hors flux tant qu'il n'a pas le focus, jamais `display: none` ni
     `visibility: hidden`, qui le retireraient de l'ordre de tabulation et le
     rendraient inatteignable — donc inutile. */
  .lien-evitement {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 200;
  }

  .lien-evitement:focus {
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 24px;
    background: var(--creme);
    color: var(--vert-profond);
    border-radius: 0 0 var(--rayon) var(--rayon);
    outline: 2px solid var(--or-lien);
    outline-offset: -4px;
    font-weight: 700;
    text-decoration: none;
  }
  h1, h2, h3 {
    font-family: var(--font-titre), Georgia, serif;
    font-weight: 500;
  }
  a { color: var(--or-lien); }
  a:hover { color: var(--encre); }
</style>
