---
import { Image } from 'astro:assets';
import { getSection } from '../../lib/content';
import EnTeteSection from '../ui/EnTeteSection.astro';
import OrnementCoin from '../ui/OrnementCoin.astro';
import photo from '../../assets/images/caro-cabinet.jpg';

const section = await getSection('parcours');
const blocs = section.blocs ?? [];
---

<section id="parcours" data-anchor="parcours" data-surface="light" class="parcours">
  <div class="grille">
    <div class="colonne-image">
      <EnTeteSection surtitre={section.surtitre ?? ''} titre={section.titre} />
      <div class="cadre">
        <Image
          src={photo}
          alt="Portrait de femme en tenue traditionnelle thaïlandaise, couronne et bijoux dorés"
          width={800}
          height={1035}
          class="photo"
        />
      </div>
    </div>

    <div class="colonne-texte">
      <div class="item">
        <div class="marqueur">
          <span class="point" aria-hidden="true"></span>
          <span class="ligne" aria-hidden="true"></span>
        </div>
        <div class="corps">
          <div class="numero">01</div>
          <p class="texte">{section.paragraphes[0]}</p>
        </div>
      </div>

      {
        blocs.map((bloc, i) => (
          <div class:list={['item', { dernier: i === blocs.length - 1 }]}>
            <div class="marqueur">
              <span class="point" aria-hidden="true" />
              <span class="ligne" aria-hidden="true" />
            </div>
            <div class="corps">
              <div class="numero">{String(i + 2).padStart(2, '0')}</div>
              <h3 class="titre-bloc">{bloc.titre}</h3>
              <p class="texte">{bloc.texte}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<div class="citation" data-surface="dark">
  <div class="orn orn-hg" style="--orn-taille: clamp(48px, 8cqw, 96px); --orn-retrait: clamp(12px, 2.6cqw, 26px); --orn-opacite: .85">
    <OrnementCoin position="haut-gauche" />
  </div>
  <div class="orn orn-hd" style="--orn-taille: clamp(48px, 8cqw, 96px); --orn-retrait: clamp(12px, 2.6cqw, 26px); --orn-opacite: .85">
    <OrnementCoin position="haut-droite" />
  </div>
  <div class="orn orn-bg" style="--orn-taille: clamp(48px, 8cqw, 96px); --orn-retrait: clamp(12px, 2.6cqw, 26px); --orn-opacite: .85">
    <OrnementCoin position="bas-gauche" />
  </div>
  <div class="orn orn-bd" style="--orn-taille: clamp(48px, 8cqw, 96px); --orn-retrait: clamp(12px, 2.6cqw, 26px); --orn-opacite: .85">
    <OrnementCoin position="bas-droite" />
  </div>
  <div class="citation-contenu">
    <span class="losange" aria-hidden="true"></span>
    <p class="citation-texte">{section.citation?.texte}</p>
    <div class="citation-auteur">{section.citation?.auteur}</div>
  </div>
</div>

<style>
  .parcours {
    scroll-margin-top: 90px;
    background: var(--creme);
    padding: clamp(96px, 17cqw, 156px) clamp(20px, 5.5cqw, 80px) clamp(80px, 14cqw, 120px);
  }

  .grille {
    max-width: var(--largeur-contenu);
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4.5cqw, 72px);
    align-items: flex-start;
  }

  .colonne-image {
    flex: 1 1 300px;
    min-width: min(100%, 280px);
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 3cqw, 26px);
  }

  .cadre {
    position: relative;
    border: 1px solid var(--or);
    padding: clamp(8px, 1.4cqw, 12px);
  }

  .photo {
    width: 100%;
    display: block;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 18%;
  }

  .colonne-texte {
    flex: 1.618 1 400px;
    min-width: min(100%, 300px);
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .item {
    display: grid;
    grid-template-columns: 20px 1fr;
    column-gap: clamp(14px, 2.6cqw, 24px);
  }

  .marqueur {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .point {
    width: 9px;
    height: 9px;
    flex: none;
    transform: rotate(45deg);
    background: var(--or);
    margin-top: 7px;
  }

  .ligne {
    width: 1px;
    flex: 1;
    background: linear-gradient(to bottom, var(--or), var(--sable));
  }

  .item.dernier .ligne {
    background: linear-gradient(to bottom, var(--or), transparent);
  }

  .corps {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: clamp(26px, 4.4cqw, 40px);
  }

  .item.dernier .corps {
    padding-bottom: 0;
  }

  .numero {
    font-family: var(--font-texte), sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.14em;
    color: var(--or-bronze);
  }

  .titre-bloc {
    margin: 0;
    font-family: var(--font-texte), sans-serif;
    font-weight: 700;
    font-size: clamp(19px, 4.6cqw, 23px);
    line-height: 1.3;
    color: var(--encre);
  }

  .texte {
    margin: 0;
    font-family: var(--font-texte), sans-serif;
    font-size: clamp(17px, 4.4cqw, 19px);
    line-height: 1.75;
    color: var(--encre-douce);
    text-wrap: pretty;
  }

  .citation {
    position: relative;
    overflow: hidden;
    background: var(--vert-profond);
    padding: clamp(64px, 13cqw, 130px) clamp(20px, 5.5cqw, 80px);
    display: flex;
    justify-content: center;
  }

  .orn {
    position: absolute;
  }

  .orn-hg {
    top: 0;
    left: 0;
  }
  .orn-hd {
    top: 0;
    right: 0;
  }
  .orn-bg {
    bottom: 0;
    left: 0;
  }
  .orn-bd {
    bottom: 0;
    right: 0;
  }

  .citation-contenu {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: center;
    text-align: center;
  }

  .losange {
    width: 9px;
    height: 9px;
    flex: none;
    transform: rotate(45deg);
    border: 1px solid var(--or);
    display: block;
  }

  .citation-texte {
    margin: 0;
    font-family: var(--font-titre), Georgia, serif;
    font-weight: 400;
    font-style: italic;
    font-size: clamp(26px, 6.8cqw, 44px);
    line-height: 1.4;
    color: var(--creme-surface);
    text-wrap: pretty;
  }

  .citation-auteur {
    font-family: var(--font-texte), sans-serif;
    font-weight: 500;
    font-size: clamp(13px, 3.2cqw, 15px);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--or);
  }

  @media (min-width: 900px) {
    .grille {
      flex-direction: row;
    }

    .colonne-image {
      position: sticky;
      top: 90px;
    }
  }
</style>
