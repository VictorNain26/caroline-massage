---
import { Image } from 'astro:assets';
import { getSection } from '../../lib/content';
import EnTeteSection from '../ui/EnTeteSection.astro';
import OrnementCoin from '../ui/OrnementCoin.astro';
import photo from '../../assets/images/caro-cabinet.jpg';

const section = await getSection('parcours');
const blocs = section.blocs ?? [];
---

<section id="parcours" data-anchor="parcours" class="parcours">
  <div class="grille">
    <div class="colonne-image">
      <EnTeteSection surtitre={section.surtitre ?? ''} titre={section.titre} />
      <div class="cadre">
        <Image
          src={photo}
          alt="Portrait de femme en tenue traditionnelle thaïlandaise, couronne et bijoux dorés"
          width={800}
          height={1035}
          class="photo"
        />
      </div>
    </div>

    <div class="colonne-texte">
      <div class="item">
        <div class="marqueur">
          <span class="point" aria-hidden="true"></span>
          <span class="ligne" aria-hidden="true"></span>
        </div>
        <div class="corps">
          <div class="numero">01</div>
          <p class="texte">{section.paragraphes[0]}</p>
        </div>
      </div>

      {/* La suite du récit se replie sur les petits écrans, comme dans le
          design : le premier bloc suffit à donner le ton, les deux autres se
          demandent. Un `<details>` natif plutôt qu'un bouton et son script —
          il porte déjà l'état, le clavier et l'annonce « développé/réduit »,
          et la page reste dépliable si rien ne s'exécute. Le contenu n'est
          jamais retiré du document : `::details-content` le laisse rendu, seule
          sa hauteur est bornée. */}
      <details class="suite">
        <summary class="suite-bouton">
          <span class="suite-libelle suite-libelle--plus">Lire la suite</span>
          <span class="suite-libelle suite-libelle--moins">Réduire</span>
        </summary>

        {
          blocs.map((bloc, i) => (
            <div class:list={['item', { dernier: i === blocs.length - 1 }]}>
              <div class="marqueur">
                <span class="point" aria-hidden="true" />
                <span class="ligne" aria-hidden="true" />
              </div>
              <div class="corps">
                <div class="numero">{String(i + 2).padStart(2, '0')}</div>
                <h3 class="titre-bloc">{bloc.titre}</h3>
                <p class="texte">{bloc.texte}</p>
              </div>
            </div>
          ))
        }
      </details>
    </div>
  </div>
</section>

<div class="citation">
  <div class="orn orn-hg" style="--orn-taille: clamp(48px, 8cqw, 96px); --orn-retrait: var(--ornement-retrait); --orn-opacite: .85">
    <OrnementCoin position="haut-gauche" />
  </div>
  <div class="orn orn-hd" style="--orn-taille: clamp(48px, 8cqw, 96px); --orn-retrait: var(--ornement-retrait); --orn-opacite: .85">
    <OrnementCoin position="haut-droite" />
  </div>
  <div class="orn orn-bg" style="--orn-taille: clamp(48px, 8cqw, 96px); --orn-retrait: var(--ornement-retrait); --orn-opacite: .85">
    <OrnementCoin position="bas-gauche" />
  </div>
  <div class="orn orn-bd" style="--orn-taille: clamp(48px, 8cqw, 96px); --orn-retrait: var(--ornement-retrait); --orn-opacite: .85">
    <OrnementCoin position="bas-droite" />
  </div>
  <div class="citation-contenu">
    <span class="losange" aria-hidden="true"></span>
    <p class="citation-texte">{section.citation?.texte}</p>
    <div class="citation-auteur">{section.citation?.auteur}</div>
  </div>
</div>

<style>
  .parcours {
    /* L'ancre vise le contenu, pas le rembourrage. Le design place son `id`
       DANS le bloc qui porte le padding, si bien que le défilement amène le
       surtitre à 90px de la barre ; ici l'`id` est sur la section, qui porte
       les deux — on atterrissait 160px plus bas, sur une bande vide. Retirer
       le rembourrage de la marge de défilement remet le surtitre où le design
       le pose, et la soustraction lit la valeur à sa source : changer le
       padding suffit, rien à reporter ici. */
    scroll-margin-top: calc(90px - var(--section-haut));
    background: var(--creme);
    padding: var(--section-haut) var(--gouttiere) var(--section-bas);
  }

  .grille {
    max-width: var(--largeur-contenu);
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4.5cqw, 72px);
    align-items: flex-start;
  }

  .colonne-image {
    flex: 1 1 300px;
    min-width: min(100%, 280px);
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 3cqw, 26px);
  }

  .cadre {
    position: relative;
    border: 1px solid var(--or);
    padding: clamp(8px, 1.4cqw, 12px);
  }

  .photo {
    width: 100%;
    /* `height: auto` sans quoi `aspect-ratio` ne sert à rien : `<Image>` écrit
       `height="1035"` dans le balisage, et un attribut de dimension agit comme
       une déclaration de style — « the ratio is only used if at least one of
       width or height is auto » (MDN, aspect-ratio, Mapping sizing attributes).
       Le cadre était donc rendu sur 1035px de haut au lieu du rapport voulu. */
    height: auto;
    display: block;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 18%;
  }

  .colonne-texte {
    flex: 1.618 1 400px;
    min-width: min(100%, 300px);
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .item {
    display: grid;
    grid-template-columns: 20px 1fr;
    column-gap: clamp(14px, 2.6cqw, 24px);
  }

  .marqueur {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .point {
    width: 9px;
    height: 9px;
    flex: none;
    transform: rotate(45deg);
    background: var(--or);
    margin-top: 7px;
  }

  .ligne {
    width: 1px;
    flex: 1;
    background: linear-gradient(to bottom, var(--or), var(--sable));
  }

  .item.dernier .ligne {
    background: linear-gradient(to bottom, var(--or), transparent);
  }

  .corps {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: clamp(26px, 4.4cqw, 40px);
  }

  .item.dernier .corps {
    padding-bottom: 0;
  }

  .numero {
    font-family: var(--font-texte), sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.14em;
    color: var(--or-lien);
  }

  .titre-bloc {
    margin: 0;
    font-family: var(--font-texte), sans-serif;
    font-weight: 700;
    font-size: clamp(19px, 4.6cqw, 23px);
    line-height: 1.3;
    color: var(--encre);
  }

  .texte {
    margin: 0;
    font-family: var(--font-texte), sans-serif;
    font-size: clamp(17px, 4.4cqw, 19px);
    line-height: 1.75;
    color: var(--encre-douce);
    text-wrap: pretty;
  }

  .citation {
    position: relative;
    overflow: hidden;
    background: var(--vert-profond);
    padding: clamp(64px, 13cqw, 130px) var(--gouttiere);
    display: flex;
    justify-content: center;
  }

  .orn {
    position: absolute;
  }

  .orn-hg {
    top: 0;
    left: 0;
  }
  .orn-hd {
    top: 0;
    right: 0;
  }
  .orn-bg {
    bottom: 0;
    left: 0;
  }
  .orn-bd {
    bottom: 0;
    right: 0;
  }

  .citation-contenu {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: center;
    text-align: center;
  }

  .losange {
    width: 9px;
    height: 9px;
    flex: none;
    transform: rotate(45deg);
    border: 1px solid var(--or);
    display: block;
  }

  .citation-texte {
    margin: 0;
    font-family: var(--font-titre), Georgia, serif;
    font-weight: 400;
    font-style: italic;
    font-size: clamp(26px, 6.8cqw, 44px);
    line-height: 1.4;
    color: var(--creme-surface);
    text-wrap: pretty;
  }

  .citation-auteur {
    font-family: var(--font-texte), sans-serif;
    font-weight: 500;
    font-size: var(--texte-surtitre);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--or);
  }

  /* Le `<summary>` passe sous le texte qu'il commande, là où le design pose son
     bouton : c'est l'ordre visuel qui change, pas l'ordre du document — le
     `summary` reste le premier enfant, comme la spécification l'exige. */
  .suite {
    display: flex;
    flex-direction: column;
  }

  .suite-bouton {
    order: 2;
    align-self: center;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 14px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-texte), sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.4;
    /* `--or-lien` et non le `#96742C` du design : 16px de texte normal
       demandent 4,5:1, que `--or-bronze` n'atteint pas sur crème (4,07). Même
       arbitrage que partout ailleurs, cf. `src/styles/tokens.css`. */
    color: var(--or-lien);
    border-bottom: 1px solid var(--or);
  }

  .suite-bouton::-webkit-details-marker {
    display: none;
  }

  .suite-bouton:focus-visible {
    outline: 2px solid var(--or-lien);
    outline-offset: 3px;
  }

  /* Replié, on garde les premiers pixels visibles sous un voile, plutôt que de
     tout escamoter : le lecteur voit qu'il y a une suite. `content-visibility`
     maintient le contenu rendu — et donc mesuré, cherché, sélectionnable —
     alors que `<details>` le retirerait. */
  .suite:not([open])::details-content {
    content-visibility: visible;
    block-size: 96px;
    overflow: hidden;
  }

  .suite:not([open]) {
    position: relative;
  }

  .suite:not([open])::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 96px;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--creme) 78%);
  }

  .suite-libelle--moins {
    display: none;
  }

  .suite[open] .suite-libelle--plus {
    display: none;
  }

  .suite[open] .suite-libelle--moins {
    display: inline;
  }

  @media (prefers-reduced-motion: no-preference) {
    .suite-bouton {
      transition:
        color 0.2s ease,
        border-color 0.2s ease;
    }
  }

  .suite-bouton:hover {
    color: var(--encre);
    border-color: var(--encre);
  }

  @media (min-width: 900px) {
    .grille {
      flex-direction: row;
    }

    /* Passé en deux colonnes, la colonne de texte a la place de tout dire : le
       repli disparaît, contenu déplié et bouton retiré. */
    .suite-bouton {
      display: none;
    }

    .suite:not([open])::details-content {
      block-size: auto;
      overflow: visible;
    }

    .suite:not([open])::after {
      content: none;
    }

    .colonne-image {
      position: sticky;
      top: 90px;
    }
  }
</style>
