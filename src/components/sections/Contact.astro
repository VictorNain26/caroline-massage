---
import { getSection, getCabinet } from '../../lib/content';
import Bouton from '../ui/Bouton.astro';
import OrnementCoin from '../ui/OrnementCoin.astro';

const section = await getSection('contact');
const cabinet = await getCabinet();

/* L'adresse est le seul libellé du site qu'aucune fenêtre étroite ne peut
   tenir d'un bloc. Sans point de coupure déclaré, le `overflow-wrap: anywhere`
   de Bouton — qui existe pour le reflow à 320px — la tranche n'importe où
   (« ...SUR / MESURE.FR »). Un `<wbr>` donne au navigateur la seule coupure
   qui se lit, et il la préfère : `anywhere` ne casse arbitrairement que
   « if there are no otherwise-acceptable break points » (CSS Text 3,
   overflow-wrap). Le domaine seul mesure 246px là où 360px en laisse 260. */
const [partieLocale, domaine] = cabinet.email.split('@');
---

<section id="contact" data-anchor="contact" class="contact">
  <div class="orn orn-hg" style="--orn-taille: clamp(56px, 9cqw, 104px); --orn-retrait: clamp(14px, 3cqw, 28px); --orn-opacite: .85">
    <OrnementCoin position="haut-gauche" />
  </div>
  <div class="orn orn-bd" style="--orn-taille: clamp(56px, 9cqw, 104px); --orn-retrait: clamp(14px, 3cqw, 28px); --orn-opacite: .85">
    <OrnementCoin position="bas-droite" />
  </div>

  <div class="conteneur">
    <div class="entete">
      <span class="surtitre">{section.surtitre}</span>
      <h2 class="titre">{section.titre}</h2>
    </div>

    <p class="accroche">{section.paragraphes[0]}</p>

    <div class="cta" style="--bouton-hauteur: 62px">
      <Bouton href={`tel:${cabinet.telephone}`} variante="creme">{cabinet.telephoneAffiche}</Bouton>
      <Bouton href={`mailto:${cabinet.email}`} variante="creme">{partieLocale}@<wbr />{domaine}</Bouton>
    </div>

    <p class="mention">Aucun paiement en ligne · réponse au plus vite</p>
  </div>
</section>

<style>
  .contact {
    /* L'ancre vise le contenu, pas le rembourrage. Le design place son `id`
       DANS le bloc qui porte le padding, si bien que le défilement amène le
       surtitre à 90px de la barre ; ici l'`id` est sur la section, qui porte
       les deux — on atterrissait 160px plus bas, sur une bande vide. Retirer
       le rembourrage de la marge de défilement remet le surtitre où le design
       le pose, et la soustraction lit la valeur à sa source : changer le
       padding suffit, rien à reporter ici. */
    scroll-margin-top: calc(90px - clamp(56px, 12cqw, 120px));
    position: relative;
    background: var(--vert-profond);
    color: var(--creme);
    padding: clamp(56px, 12cqw, 120px) var(--gouttiere);
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4.5cqw, 44px);
  }

  .orn {
    position: absolute;
  }

  .orn-hg {
    top: 0;
    left: 0;
  }

  .orn-bd {
    bottom: 0;
    right: 0;
  }

  .conteneur {
    max-width: 680px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(18px, 3cqw, 26px);
  }

  .entete {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .surtitre {
    font-family: var(--font-texte), sans-serif;
    font-weight: 500;
    font-size: var(--texte-surtitre);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* --sable mesure 6.48:1 sur --vert-profond, au-dessus du plancher 4.5:1 ;
       --or-bronze (utilisé par défaut ailleurs) n'y mesure que 2.90:1. */
    color: var(--sable);
  }

  .titre {
    margin: 0;
    font-family: var(--font-titre), Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 8.2cqw, 56px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .accroche {
    margin: 0;
    font-family: var(--font-texte), sans-serif;
    font-size: clamp(17px, 4.4cqw, 19px);
    line-height: 1.75;
    color: var(--creme-surface);
    text-wrap: pretty;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 4px;
    /* Le domaine mesure 247px pour 248 disponibles à 360px : il déborde d'un
       pixel, et d'un seul, parce que l'interlettrage du bouton compte aussi
       après la dernière lettre. Six pixels de marge en moins l'accueillent
       sans toucher au libellé ni à l'interlettrage, qui appartiennent à la
       ligne graphique. Au-delà, la place ne manque plus. */
    --bouton-marge-h: 24px;
  }

  @media (min-width: 420px) {
    .cta {
      --bouton-marge-h: 30px;
    }
  }

  /* Le design coiffe le bloc d'appel à l'action d'un filet (ligne 664) ; le
     formulaire a disparu, la mention qu'il souligne est restée, et ce filet
     l'assoit sous les deux boutons. */
  .mention {
    margin: 0;
    /* Le filet du design coiffe un bloc pleine largeur ; ici il est porté par
       le paragraphe, qui dans une colonne `align-items: center` se rétracte à
       la largeur de son texte. Le trait s'arrêtait donc bien avant les boutons
       qu'il souligne. */
    align-self: stretch;
    padding-top: clamp(16px, 2.6cqw, 22px);
    border-top: 1px solid color-mix(in srgb, var(--or-clair) 28%, transparent);
    font-family: var(--font-texte), sans-serif;
    font-size: 15px;
    line-height: 1.5;
    color: var(--sable);
  }
</style>
