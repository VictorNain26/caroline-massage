---
import { getSection } from '../../lib/content';
import Bouton from '../ui/Bouton.astro';
import OrnementCoin from '../ui/OrnementCoin.astro';

const section = await getSection('hero');

// Le design met en emphase le dernier segment du titre (em, doré) ; le
// reste du texte reste dans le corps du h1. Les deux portent leur propre
// animation wordIn, comme dans le design (lignes 167).
const accent = 'vos tensions.';
const aAccent = section.titre.endsWith(accent);
const titrePlain = aAccent ? section.titre.slice(0, -accent.length) : section.titre;
---

<section id="hero" data-anchor="hero" class="hero">
  <div aria-hidden="true" class="rideau">
    <span class="rideau-marque">Caroline</span>
    <span class="rideau-trait"></span>
  </div>

  <div aria-hidden="true" class="lueur"></div>
  <div aria-hidden="true" class="cadre"></div>

  <div class="orn orn-bas-gauche" style="--orn-taille: clamp(72px, 8cqw, 92px); --orn-retrait: calc(clamp(15px, 2.6cqw, 34px) + 14px); --orn-opacite: .75">
    <OrnementCoin position="bas-gauche" />
  </div>
  <div class="orn orn-bas-droite" style="--orn-taille: clamp(72px, 8cqw, 92px); --orn-retrait: calc(clamp(15px, 2.6cqw, 34px) + 14px); --orn-opacite: .75">
    <OrnementCoin position="bas-droite" />
  </div>

  <div class="contenu">
    <span class="eyebrow">{section.surtitre}</span>
    <h1 class="titre">{titrePlain}{aAccent && <em class="titre-accent">{accent}</em>}</h1>
    <p class="accroche">{section.paragraphes[0]}</p>
    <div class="cta" style="--bouton-hauteur: clamp(58px, 9.4cqw, 62px)">
      <Bouton href="#contact" variante="creme">Réserver</Bouton>
    </div>
  </div>

  <div class="indice-bloc">
    <a href="#soins" class="indice">
      <span class="indice-texte">Découvrir les soins</span>
      <span aria-hidden="true" class="indice-cercle">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v13M6 12l6 6 6-6"></path>
        </svg>
      </span>
    </a>
  </div>
</section>

<style>
  /* Pas de `width: 100%` ici : le projet n'a pas de remise à zéro
     `box-sizing: border-box`, donc `width` désigne la boîte de contenu et
     `100%` + le `padding` ci-dessous débordait la fenêtre de deux fois le
     padding. Une section de niveau bloc remplit déjà sa largeur disponible. */
  .hero {
    scroll-margin-top: 90px;
    position: relative;
    /* Plein écran, jamais plus : `box-sizing` fait tenir le rembourrage dans
       les 100cqh au lieu de s'y ajouter, et le rembourrage vertical se mesure
       sur la hauteur du viewport — sur la largeur, un grand écran le poussait
       à 344px et repoussait le bouton sous la ligne de flottaison. Reste en
       `min-height` : si le texte grandit, la section s'étire plutôt que de
       masquer sa propre fin. */
    box-sizing: border-box;
    min-height: 100cqh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: clamp(88px, 14cqh, 150px) clamp(30px, 7cqw, 80px) clamp(110px, 18cqh, 180px);
    background: var(--vert-profond);
    text-align: center;
  }

  /* `fixed`, pas `absolute` : le rideau doit couvrir l'écran entier, pas
     seulement la boîte du hero, sans quoi la page se devine sous lui pendant
     l'intro. */
  .rideau {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 2.4cqw, 20px);
    background: var(--vert-profond);
    border-bottom: 1px solid color-mix(in srgb, var(--or) 55%, transparent);
    pointer-events: none;
    /*
     * Off-screen by default (also the permanent state under reduced motion,
     * which never applies curtainLift below) — without this, a visitor with
     * reduced motion would see the curtain forever, hiding the whole hero.
     */
    transform: translateY(-101%);
  }

  .rideau-marque {
    font: 400 clamp(30px, 8cqw, 56px) / 1 var(--font-titre), serif;
    color: var(--creme);
  }

  .rideau-trait {
    width: clamp(52px, 12cqw, 84px);
    height: 1px;
    background: color-mix(in srgb, var(--or-clair) 75%, transparent);
    transform-origin: center;
  }

  .lueur {
    position: absolute;
    left: 50%;
    top: 44%;
    width: 150%;
    height: 118%;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--vert-clair) 92%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .cadre {
    position: absolute;
    top: clamp(15px, 2.6cqw, 34px);
    left: clamp(15px, 2.6cqw, 34px);
    right: clamp(15px, 2.6cqw, 34px);
    bottom: clamp(15px, 2.6cqw, 34px);
    border: 1px solid color-mix(in srgb, var(--or) 26%, transparent);
    pointer-events: none;
  }

  .orn {
    display: none;
    position: absolute;
  }

  .orn-bas-gauche {
    bottom: 0;
    left: 0;
  }

  .orn-bas-droite {
    bottom: 0;
    right: 0;
  }

  .contenu {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow {
    font: 500 clamp(11px, 2.4cqw, 14px) / 1.4 var(--font-texte), sans-serif;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sable);
  }

  .titre {
    margin: clamp(12px, 2cqw, 18px) 0 0;
    max-width: 16ch;
    font: 400 clamp(37px, 10.2cqw, 80px) / 1.14 var(--font-titre), serif;
    letter-spacing: -0.015em;
    color: var(--creme);
    text-wrap: balance;
  }

  .titre-accent {
    display: inline-block;
    font-style: italic;
    color: var(--or-clair);
  }

  .accroche {
    margin: clamp(14px, 2.2cqw, 20px) 0 0;
    max-width: 46ch;
    font: 400 clamp(17px, 4.4cqw, 22px) / 1.5 var(--font-titre), serif;
    font-style: italic;
    color: var(--sable);
  }

  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: clamp(24px, 4.2cqw, 38px);
  }

  .indice-bloc {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(clamp(15px, 2.6cqw, 34px) + clamp(20px, 2.6cqw, 30px));
    z-index: 2;
    display: flex;
    justify-content: center;
  }

  .indice {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    color: var(--sable);
    text-decoration: none;
  }

  .indice:hover {
    color: var(--creme);
  }

  .indice:focus-visible {
    outline: 2px solid var(--or);
    outline-offset: 6px;
  }

  .indice-texte {
    font: 500 clamp(10px, 2.5cqw, 12px) / 1 var(--font-texte), sans-serif;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .indice-cercle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--or-clair) 50%, transparent);
    color: var(--or-clair);
  }

  @media (min-width: 900px) {
    .orn {
      display: block;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rideau {
      animation: curtainLift 0.8s cubic-bezier(0.2, 0.7, 0.3, 1) 1.9s both;
    }
    .rideau-marque {
      animation:
        curtainMarkIn 0.7s cubic-bezier(0.2, 0.7, 0.3, 1) both,
        curtainMarkOut 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) 1.3s both;
    }
    .rideau-trait {
      animation: curtainRuleIn 0.6s cubic-bezier(0.2, 0.7, 0.3, 1) 0.3s both;
    }
    .lueur {
      animation: glowIn 1.7s cubic-bezier(0.2, 0.7, 0.3, 1) both;
    }
    .cadre {
      animation: frameIn 1.3s cubic-bezier(0.2, 0.7, 0.3, 1) 0.12s both;
    }
    .orn-bas-gauche {
      animation: ornIn 1.2s cubic-bezier(0.2, 0.7, 0.3, 1) 0.5s both;
    }
    .orn-bas-droite {
      animation: ornIn 1.2s cubic-bezier(0.2, 0.7, 0.3, 1) 0.68s both;
    }
    .eyebrow {
      animation: eyebrowIn 1.1s cubic-bezier(0.2, 0.7, 0.3, 1) 0.42s both;
    }
    .titre {
      animation: wordIn 1.1s cubic-bezier(0.2, 0.7, 0.3, 1) 0.6s both;
    }
    .titre-accent {
      animation: wordIn 1.1s cubic-bezier(0.2, 0.7, 0.3, 1) 0.82s both;
    }
    .accroche {
      animation: heroUp 0.9s cubic-bezier(0.2, 0.7, 0.3, 1) 1.02s both;
    }
    .cta {
      animation: heroUp 0.9s cubic-bezier(0.2, 0.7, 0.3, 1) 1.18s both;
    }
    .indice-bloc {
      animation: heroFade 0.8s ease 1.5s both;
    }
    .indice-cercle {
      animation: cueBob 2.6s ease-in-out 2.6s infinite;
    }

    @keyframes curtainLift {
      from {
        transform: translateY(0);
      }
      to {
        transform: translateY(-101%);
      }
    }
    @keyframes curtainMarkIn {
      from {
        opacity: 0;
        letter-spacing: 0.3em;
      }
      to {
        opacity: 1;
        letter-spacing: -0.02em;
      }
    }
    @keyframes curtainMarkOut {
      from {
        opacity: 1;
        transform: translateY(0);
      }
      to {
        opacity: 0;
        transform: translateY(-14px);
      }
    }
    @keyframes curtainRuleIn {
      from {
        transform: scaleX(0);
        opacity: 0;
      }
      to {
        transform: scaleX(1);
        opacity: 1;
      }
    }
    @keyframes glowIn {
      from {
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.88);
      }
      to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
      }
    }
    @keyframes frameIn {
      from {
        opacity: 0;
        transform: scale(1.04);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }
    @keyframes ornIn {
      from {
        opacity: 0;
        transform: scale(0.86);
      }
      to {
        opacity: 0.85;
        transform: scale(1);
      }
    }
    @keyframes eyebrowIn {
      from {
        opacity: 0;
        letter-spacing: 0.42em;
      }
      to {
        opacity: 1;
        letter-spacing: 0.2em;
      }
    }
    @keyframes wordIn {
      from {
        opacity: 0;
        transform: translateY(22px);
        filter: blur(9px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
    }
    @keyframes heroUp {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes heroFade {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
    @keyframes cueBob {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(5px);
      }
    }
  }
</style>
