---
import { getSection } from '../../lib/content';

const section = await getSection('tarifs');
---

<section id="tarifs" data-anchor="tarifs" class="tarifs">
  <span class="losange" aria-hidden="true" />
  <p class="amorce">{section.titre}</p>
  <p class="texte">{section.paragraphes[0]}</p>
</section>

<style>
  /* Le fond court sur toute la largeur : le design ne fait pas de #tarifs une
     boîte, il le pose dans le même wrapper plein cadre que #soins (ligne 180).
     C'est le contenu qui est bridé à 720px, pas la surface beige.
     L'écart au sommet vaut le `gap` de ce wrapper PLUS le `margin-top` propre
     à #tarifs (design ligne 362) — la scission en deux sections a supprimé le
     premier, qui ne s'applique qu'entre frères d'un même conteneur flex. */
  .tarifs {
    scroll-margin-top: 90px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(10px, 1.8cqw, 14px);
    background: var(--creme-surface);
    padding: calc(clamp(28px, 4.5cqw, 48px) + clamp(18px, 3cqw, 34px))
      var(--gouttiere) var(--section-bas);
  }

  .amorce,
  .texte {
    max-width: 720px;
  }

  .losange {
    width: 9px;
    height: 9px;
    flex: none;
    transform: rotate(45deg);
    border: 1px solid var(--or);
    display: block;
  }

  .amorce {
    margin: 0;
    font-family: var(--font-titre), Georgia, serif;
    font-weight: 400;
    font-style: italic;
    font-size: clamp(21px, 5.2cqw, 28px);
    line-height: 1.35;
    color: var(--encre);
    text-wrap: pretty;
  }

  .texte {
    margin: 0;
    font-family: var(--font-texte), sans-serif;
    font-size: var(--texte-corps);
    line-height: 1.7;
    color: var(--encre-douce);
    text-wrap: pretty;
  }
</style>
