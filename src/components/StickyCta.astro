---
import { getCabinet } from '../lib/content';

const cabinet = await getCabinet();
---

<a
  href={`tel:${cabinet.telephone}`}
  class="barre"
  data-sticky-cta
  data-sur="light"
  data-visible="false"
>
  {cabinet.telephoneAffiche}
</a>

<script src="../scripts/sticky-cta.ts"></script>

<style>
  .barre {
    position: fixed;
    left: 50%;
    bottom: clamp(14px, 3cqw, 24px);
    z-index: 25;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 28px;
    border-radius: 999px;
    font: 700 0.875rem/1 var(--font-texte), sans-serif;
    letter-spacing: 0.06em;
    text-decoration: none;
    box-shadow: 0 14px 32px rgba(11, 58, 49, 0.22);
    transform: translate(-50%, calc(100% + 24px));
    opacity: 0;
    pointer-events: none;
  }

  .barre[data-visible='true'] {
    opacity: 1;
    pointer-events: auto;
  }

  .barre[data-sur='light'] {
    background: var(--vert-profond);
    color: var(--creme);
    border: 1px solid color-mix(in srgb, var(--or-clair) 32%, transparent);
  }

  .barre[data-sur='light']:hover {
    background: var(--vert-clair);
  }

  .barre[data-sur='dark'] {
    background: var(--creme);
    color: var(--vert-profond);
    border: 1px solid color-mix(in srgb, var(--or) 45%, transparent);
  }

  .barre[data-sur='dark']:hover {
    background: var(--or-clair);
  }

  .barre:focus-visible {
    outline: 2px solid var(--or);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .barre {
      transition:
        transform 0.3s ease,
        opacity 0.3s ease,
        background 0.25s ease,
        color 0.25s ease,
        border-color 0.25s ease;
    }

    .barre[data-visible='true'] {
      transform: translate(-50%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .barre[data-visible='true'] {
      transform: translate(-50%, 0);
    }
  }
</style>
