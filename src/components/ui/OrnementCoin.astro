---
import { Image } from 'astro:assets';
import coin from '../../assets/images/caro-ornement-coin.png';

interface Props {
  position: 'haut-gauche' | 'haut-droite' | 'bas-gauche' | 'bas-droite';
}

const { position } = Astro.props;
---

<Image
  src={coin}
  alt=""
  width={104}
  height={104}
  densities={[1, 2]}
  class={`ornement ${position}`}
/>

<style>
  /* Points d'extension, posés par la section qui consomme le composant sur
     son propre conteneur. Ne pas en faire des props : le design donne une
     valeur différente par section (hero, parcours, contact), et des props ne
     feraient que relayer trois fois des styles inline.
       --orn-taille   largeur de l'ornement
       --orn-retrait  retrait par rapport au bord qu'il longe
       --orn-opacite  opacité
     Les valeurs de repli ci-dessous sont celles de parcours, le cas le plus
     fréquent. */
  .ornement {
    position: absolute;
    width: var(--orn-taille, clamp(48px, 8cqw, 96px));
    height: auto;
    opacity: var(--orn-opacite, 0.85);
    pointer-events: none;
  }
  .haut-gauche {
    top: var(--orn-retrait, var(--ornement-retrait));
    left: var(--orn-retrait, var(--ornement-retrait));
  }
  .haut-droite {
    top: var(--orn-retrait, var(--ornement-retrait));
    right: var(--orn-retrait, var(--ornement-retrait));
    transform: scaleX(-1);
  }
  .bas-gauche {
    bottom: var(--orn-retrait, var(--ornement-retrait));
    left: var(--orn-retrait, var(--ornement-retrait));
    transform: scaleY(-1);
  }
  .bas-droite {
    bottom: var(--orn-retrait, var(--ornement-retrait));
    right: var(--orn-retrait, var(--ornement-retrait));
    transform: rotate(180deg);
  }
</style>
