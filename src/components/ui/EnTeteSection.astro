---
interface Props {
  surtitre: string;
  titre: string;
}

const { surtitre, titre } = Astro.props;
---

<div class="entete">
  <div class="ligne-surtitre">
    <span class="filet" aria-hidden="true"></span>
    <span class="surtitre">{surtitre}</span>
  </div>
  <h2 class="titre">{titre}</h2>
</div>

<style>
  .entete {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ligne-surtitre {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .filet {
    width: 1px;
    height: 22px;
    flex: none;
    background: var(--or);
  }
  .surtitre {
    /*
     * --or-lien, not the design's --or-bronze: #96742c measured 4.07:1 on
     * --creme and 3.51:1 on --creme-surface, under the 4.5:1 floor for
     * normal-size text, and axe flagged all four eyebrows. Substitution
     * approved by the project owner — do not restore #96742c from the design.
     *
     * --entete-couleur-surtitre stays the escape hatch for a dark section:
     * --or-lien is 1.99:1 on the dark green (--or-bronze was 2.90:1, no
     * better). A dark section must set it to var(--sable) (6.48:1), as the
     * design does at contact.
     */
    font-family: var(--font-texte), sans-serif;
    font-weight: 500;
    font-size: clamp(13px, 3.2cqw, 15px);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--entete-couleur-surtitre, var(--or-lien));
  }
  .titre {
    margin: 0;
    font-family: var(--font-titre), Georgia, serif;
    font-weight: 500;
    font-size: clamp(30px, 7.6cqw, 52px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
</style>
