---
interface Props {
  surtitre: string;
  titre: string;
}

const { surtitre, titre } = Astro.props;
---

<div class="entete">
  <div class="ligne-surtitre">
    <span class="filet" aria-hidden="true"></span>
    <span class="surtitre">{surtitre}</span>
  </div>
  <h2 class="titre">{titre}</h2>
</div>

<style>
  .entete {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ligne-surtitre {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .filet {
    width: 1px;
    height: 22px;
    flex: none;
    background: var(--or);
  }
  .surtitre {
    /* Une section sombre doit poser `--entete-couleur-surtitre: var(--sable)`,
       comme le fait contact : l'or du texte ne passe pas sur le vert profond
       (voir le choix de `--or-lien` dans tokens.css). */
    font-family: var(--font-texte), sans-serif;
    font-weight: 500;
    font-size: var(--texte-surtitre);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--entete-couleur-surtitre, var(--or-lien));
  }
  .titre {
    margin: 0;
    font-family: var(--font-titre), Georgia, serif;
    font-weight: 500;
    font-size: clamp(30px, 7.6cqw, 52px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
</style>
