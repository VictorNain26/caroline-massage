---
interface Props {
  titre: string;
}

const { titre } = Astro.props;
---

<details class="accordeon">
  <summary>
    <span class="titre">{titre}</span>
    <span class="marque" aria-hidden="true"></span>
  </summary>
  <div class="corps"><slot /></div>
</details>

<style>
  .accordeon {
    border-bottom: 1px solid color-mix(in srgb, var(--or) 30%, transparent);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: 2px solid var(--or);
    outline-offset: 3px;
  }
  .titre {
    font-family: var(--font-titre), Georgia, serif;
    font-size: 1.15rem;
  }
  .marque {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    border: 1.5px solid var(--or-bronze);
    color: var(--or-bronze);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .marque::before {
    content: '+';
  }
  details[open] .marque {
    transform: rotate(45deg);
  }
  .corps {
    padding-bottom: 20px;
    color: var(--encre-douce);
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marque {
      transition: transform 0.25s ease;
    }
  }
</style>
