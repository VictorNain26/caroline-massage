---
interface Props {
  titre: string;
}

const { titre } = Astro.props;
---

<details class="accordeon">
  <summary>
    <span class="icone" aria-hidden="true"><slot name="icone" /></span>
    <span class="titre">{titre}</span>
    <span class="marque" aria-hidden="true"></span>
  </summary>
  <div class="corps"><slot /></div>
</details>

<style>
  /*
   * --accordeon-couleur-{titre,corps,marque,bordure} let a dark item (the
   * signature soin card) override the four text/border colours from its own
   * wrapper, same custom-property-extension-point pattern as
   * EnTeteSection's --entete-couleur-surtitre. Defaults are the light
   * treatment used everywhere else.
   */
  .accordeon {
    border-bottom: 1px solid var(--accordeon-couleur-bordure, var(--sable));
  }
  summary {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: 2px solid var(--or);
    outline-offset: 3px;
  }
  .icone {
    flex: none;
    display: flex;
    color: var(--or);
  }
  .icone:empty {
    display: none;
  }
  .titre {
    flex: 1;
    min-width: 0;
    font-family: var(--font-titre), Georgia, serif;
    font-size: 1.15rem;
    color: var(--accordeon-couleur-titre, var(--encre));
  }
  .marque {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    border: 1.5px solid var(--accordeon-couleur-marque, var(--or-bronze));
    color: var(--accordeon-couleur-marque, var(--or-bronze));
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .marque::before {
    content: '+';
  }
  details[open] .marque {
    transform: rotate(45deg);
  }
  .corps {
    padding-bottom: 20px;
    color: var(--accordeon-couleur-corps, var(--encre-douce));
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marque {
      transition: transform 0.25s ease;
    }
  }
</style>
