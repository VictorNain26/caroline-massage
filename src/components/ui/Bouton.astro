---
interface Props {
  href: string;
  variante?: 'vert' | 'creme';
}

const { href, variante = 'vert' } = Astro.props;
---

<a href={href} class={`bouton ${variante}`}><slot /></a>

<style>
  /*
   * --bouton-hauteur is the extension point for min-height, since the
   * design uses a different one per site (nav, mobile menu, hero) — same
   * pattern as OrnementCoin's custom properties. Default matches the nav.
   */
  .bouton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--bouton-hauteur, 48px);
    padding: 0 24px;
    border-radius: var(--rayon);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .vert {
    background: var(--vert-profond);
    color: var(--creme);
    border: 1px solid color-mix(in srgb, var(--or-clair) 32%, transparent);
  }
  .vert:hover {
    background: var(--vert-clair);
    color: var(--creme);
  }
  .creme {
    background: var(--creme);
    color: var(--vert-profond);
    border: 1px solid color-mix(in srgb, var(--or) 45%, transparent);
  }
  .creme:hover {
    background: var(--or-clair);
    color: var(--vert-profond);
  }
  .bouton:focus-visible {
    outline: 2px solid var(--or);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bouton {
      transition:
        background 0.25s ease,
        color 0.25s ease,
        border-color 0.25s ease,
        transform 0.25s ease;
    }
    .bouton:active {
      transform: scale(0.985);
    }
  }
</style>
