---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page introuvable | Caroline, massage sur-mesure"
  description="Cette page n'existe pas ou plus."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <main id="contenu" class="page">
    <div class="conteneur">
      <span class="surtitre">Erreur 404</span>
      <h1 class="titre">Cette page n'existe pas.</h1>
      <p class="texte">
        Le lien suivi est peut-être erroné, ou la page a été déplacée.
      </p>
      <a href="/" class="lien-retour">Retour à l'accueil</a>
    </div>
  </main>
</Base>

<style>
  .page {
    background: var(--creme);
    padding: var(--section-haut) var(--gouttiere);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60cqh;
  }

  .conteneur {
    max-width: 48ch;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .surtitre {
    font-family: var(--font-texte), sans-serif;
    font-weight: 500;
    font-size: var(--texte-surtitre);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--or-lien);
  }

  .titre {
    margin: 0;
    font-family: var(--font-titre), Georgia, serif;
    font-weight: 500;
    font-size: clamp(30px, 7.6cqw, 44px);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .texte {
    margin: 0;
    font-family: var(--font-texte), sans-serif;
    font-size: var(--texte-corps);
    line-height: 1.65;
    color: var(--encre-douce);
  }

  .lien-retour {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 8px;
    padding: 0 4px;
    font-family: var(--font-texte), sans-serif;
    font-weight: 500;
    font-size: 16px;
    color: var(--or-lien);
    border-bottom: 1px solid var(--sable);
    text-decoration: none;
  }

  .lien-retour:hover {
    color: var(--encre);
  }

  .lien-retour:focus-visible {
    outline: 2px solid var(--or-lien);
    outline-offset: 3px;
  }
</style>
